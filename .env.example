# Vesper — environment variable NAMES only (§4, §18). Never put values here.
# On Vercel, add each one under Settings → Environment Variables and mark
# every secret as "Sensitive". Nothing here may use a NEXT_PUBLIC_ prefix.

# Public origin of the PWA, e.g. https://your-project.vercel.app
APP_ORIGIN=
# WebAuthn relying-party id (defaults to the APP_ORIGIN hostname)
RP_ID=

# One-time token for first setup (≥ 32 random characters). Delete it after setup. [secret]
SETUP_TOKEN=
# 32 random bytes, base64url — encrypts the TOTP secret at rest. [secret]
TOTP_ENC_KEY=

# Web Push (VAPID). The private key is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Database (OD1: Cloudflare D1 over REST)
DB_DRIVER=
D1_ACCOUNT_ID=
D1_DATABASE_ID=
# Cloudflare API token limited to D1 edit on this account. [secret]
D1_API_TOKEN=
# "batch" (default) or "sequential"
D1_BATCH_MODE=

# Local development only (DB_DRIVER=sqlite)
SQLITE_PATH=
